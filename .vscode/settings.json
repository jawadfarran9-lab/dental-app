{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "files.watcherExclude": {
    "**/SynologyDrive/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/SynologyDrive/**": true
  },
  "typescript.tsserver.watchOptions": {
    "excludeDirectories": ["**/node_modules"]
  }
}
